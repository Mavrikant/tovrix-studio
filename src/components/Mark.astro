---
// The Tovrix Studio mark: three blocks stacked into a T. The pillar follows the text colour of the theme.
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <rect x="10" y="10" width="44" height="14" rx="4" fill="var(--coral)" transform="rotate(-6 32 17)" />
  <rect x="24" y="27" width="16" height="12" rx="4" fill="var(--ink)" />
  <rect x="24" y="42" width="16" height="12" rx="4" fill="var(--ink)" />
</svg>
