---
import Layout from '../layouts/Layout.astro';
import { text } from '../data/site';
import { page } from '../lib/paths';
---
<Layout lang="en" path="" title="404 · Tovrix Studio" description={text.en.notFound}>
  <section class="hero small">
    <div class="wrap">
      <h1>404</h1>
      <p class="lead">{text.en.notFound} / {text.tr.notFound}</p>
      <p><a class="btn" href={page('en')}>{text.en.home}</a> <a class="btn ghost" href={page('tr')}>{text.tr.home}</a></p>
    </div>
  </section>
</Layout>
